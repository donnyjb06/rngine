  "simulation_count": 1,
  "pulls_per_simulation": 2,
  "duplicate_mode": "hard_prevention",
  "seed": 1234,
  "item_selection_mode": "equal_chance",
  "probability_mode": "percentage",
  "rarities": [
    {
      "name": "Common",
      "weight": 70,
      "probability": 100,
      "items": [
        {
          "name": "Iron Sword"
